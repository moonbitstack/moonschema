name = "moonbitstack/moonschema"

version = "0.2.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonschema"

license = "Apache-2.0"

keywords = [
  "json-schema",
  "schema",
  "validation",
  "openapi",
  "json",
  "moonbit",
]

description = "JSON Schema validation for MoonBit, draft-04 through v1: four output formats, nineteen format names, and vocabularies from outside."

source = "src"

import {
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonregex@0.1.2",
  "moonbitstack/moonurl@0.2.3",
}
