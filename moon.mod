name = "moonbitstack/moonschema"

version = "0.2.5"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonschema"

license = "Apache-2.0"

keywords = [
  "json-schema",
  "jsonschema",
  "schema",
  "validation",
  "validator",
  "draft-04",
  "draft-06",
  "draft-07",
  "draft-2019-09",
  "draft-2020-12",
  "openapi",
  "json",
  "format",
  "vocabulary",
  "moonbit",
]

description = "JSON Schema validation for MoonBit, draft-04 through v1: four output formats, nineteen format names, and vocabularies from outside."

source = "src"

import {
  "moonbitstack/moondate@0.1.6",
  "moonbitstack/moonregex@0.1.5",
  "moonbitstack/moonurl@0.2.6",
  "moonbitstack/moonjson@0.5.0",
}
