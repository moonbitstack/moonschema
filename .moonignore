# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/

# The acceptance gate is a module of its own, with its own dependencies, the
# metaschemas it feeds the validator, and the specification and official test
# suite as submodules. It measures the library; it is not part of it.
gate/
