# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/

# The specification and the official test suite are submodules: they are how CI
# proves conformance, and they are several times the size of this library. A
# consumer installing the package wants the validator, not the paperwork.
spec/
suite/

# The acceptance gate is a module of its own, with its own dependencies and the
# metaschemas it feeds the validator. It measures the library; it is not part of
# it.
gate/
